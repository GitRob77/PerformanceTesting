{
  "manifest_version": 3,
  "name": "SAP Fiori HTTP Recorder",
  "short_name": "Fiori Recorder",
  "version": "0.3.0",
  "description": "Record, replay, and load-test SAP Fiori HTTP traffic with CSRF correlation.",

  "permissions": [
    "debugger",
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "sidePanel"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "SAP Fiori HTTP Recorder — click to open side panel"
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
