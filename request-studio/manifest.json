{
  "manifest_version": 3,
  "name": "UiPath Request Studio",
  "version": "1.0",
  "description": "Capture, edit, and replay HTTP requests with full header and body control",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "debugger",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["viewer.html", "viewer.js"],
    "matches": ["<all_urls>"]
  }]
}
